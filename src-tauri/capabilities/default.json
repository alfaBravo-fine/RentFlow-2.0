{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability configuration for RentFlow desktop application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:window:default",
    "oauth:default",
    "store:default",
    "updater:default",
    "autostart:default",
    "dialog:default",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-write-file",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
